<section class="mt-50 mb-50">
  <div class="container">
    <h2>My Wishlist</h2>
    <div class="row">
      <div class="col-12">
        <div class="table-responsive">
          <table class="table shopping-summery text-center">
            <thead>
              <tr class="main-heading">
                <th scope="col" colspan="2">Product</th>
                <th scope="col">Price</th>
                <th scope="col">Stock Status</th>
                <th scope="col">Action</th>
                <th scope="col">Remove</th>
              </tr>
            </thead>
            <tbody>
              {{!-- {{#each wishList}} --}}
              {{!-- <tr>
                <td class="image product-thumbnail"><img
                    src="{{this.productImage}}"
                    alt="#"
                  /></td>
                <td class="product-des product-name">
                  <h5 class="product-name"><a
                      href="shop-product-right.html"
                    >{{this.productName}}</a></h5>
                  <p class="font-xs">{{this.category}}
                  </p>
                </td>
                <td class="price" data-title="Price"><span>₹{{this.discountPrice}}</span></td>
                <td class="text-center" data-title="Stock">
                  <span class="color3 font-weight-bold">{{this.stockStatus}}</span>
                </td>
                <td class="text-right" data-title="Cart">
                  <button class="btn btn-sm"><i
                      class="fi-rs-shopping-bag mr-5"
                    ></i>Add to cart</button>
                </td>
                <td class="action" data-title="Remove"><a href="#"><i
                      class="fi-rs-trash"
                    ></i></a></td>
              </tr> --}}
              {{#each wishList}}
                <tr>
                  <td class="image product-thumbnail">
                    <img src="{{this.thumbnail}}" alt="#" />
                  </td>

                  <td class="product-des product-name">
                    <h5>{{this.productName}}</h5>
                    <p class="font-xs">{{this.category}}</p>
                  </td>

                  <td>₹{{this.price}}</td>

                  <td>
                    <span class="color3 font-weight-bold">In Stock</span>
                  </td>

                  <td>
                    <form
                      action="/add-to-cart"
                      method="POST"
                      style="display: inline;"
                    >
                      <input
                        type="hidden"
                        name="productId"
                        value="{{this.productId}}"
                      />
                      <button
                        type="submit"
                        aria-label="Add To Cart"
                        class="btn btn-sm"
                      >Add to cart</button>
                    </form>
                  </td>

                  <td>
                    <a href="/wishlist/remove/{{this.productId}}">
                      <i class="fi-rs-trash"></i>
                    </a>
                  </td>
                </tr>
              {{/each}}

              {{!-- {{/each}} --}}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>