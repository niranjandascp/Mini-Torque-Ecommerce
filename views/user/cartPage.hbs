<section class="mt-50 mb-50">
  <div class="container">
          <h1>My Cart</h1>
    <div class="row">
      <div class="col-12">
        <div class="table-responsive">
          <table class="table shopping-summery text-center">
            <thead>
              <tr class="main-heading">
                <th scope="col">Image</th>
                <th scope="col">Name</th>
                <th scope="col">Price</th>
                <th scope="col">Quantity</th>
                <th scope="col">Subtotal</th>
                <th scope="col">Remove</th>
              </tr>
            </thead>
            <tbody>

              {{#each userCart}}
                <tr>
                  <td class="image product-thumbnail"><img
                      src="{{this.productImages}}"
                      alt="#"
                    /></td>
                  <td class="product-des product-name">
                    <h5 class="product-name"><a
                        href="/productDetails?id={{this.productId}}"
                      >{{this.productName}}</a></h5>
                    <p class="font-xs">{{this.shortDescription}}
                    </p>
                  </td>
                  <td class="price" data-title="Price"><span>₹
                      {{this.price}}
                    </span></td>
                  <td class="text-center" data-title="Stock">
                    <div class="detail-qty border radius m-auto">
                      <a href="#" class="qty-down"><i
                          class="fi-rs-angle-small-down"
                        ></i></a>
                      <span class="qty-val">{{this.quantity}}</span>
                      <a href="#" class="qty-up"><i
                          class="fi-rs-angle-small-up"
                        ></i></a>
                    </div>
                  </td>
                  <td class="text-right" data-title="Cart">
                    <span>₹ {{this.total}} </span>
                  </td>
                  <td class="action" data-title="Remove"><a
                      href="/cart/remove/{{this.productId}}"
                      class="text-muted"
                    ><i class="fi-rs-trash"></i></a></td>
                </tr>
              {{/each}}

              <tr>
                <td colspan="6" class="text-end">
                  <a href="/cart/clear" class="text-muted">
                    <i class="fi-rs-cross-small"></i>
                    Clear Cart</a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="divider center_icon mt-50 mb-50"><i
            class="fi-rs-fingerprint"
          ></i></div>
        <div class="row mb-50">
          <div class="col-lg-12 col-md-12">
            <div class="border p-md-4 p-30 border-radius cart-totals">
              <div class="heading_s1 mb-3">
                <h4>Cart Totals</h4>
              </div>
              <div class="table-responsive">
                <table class="table">
                  <tbody>
                    <tr>
                      <td class="cart_total_label">Shipping</td>
                      <td class="cart_total_amount">
                        <i class="ti-gift mr-1"></i>
                        Free Shipping</td>
                    </tr>
                    <tr>
                      <td class="cart_total_label">Total</td>
                      <td class="cart_total_amount"><strong><span
                            class="font-xl fw-900 text-brand"
                          >₹ {{subtotal}}</span></strong></td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <a href="/checkout" class="btn">
                <i class="fi-rs-box-alt mr-10"></i>
                Proceed To CheckOut</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>